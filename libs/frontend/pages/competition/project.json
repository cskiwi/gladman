{
  "name": "frontend-pages-competition",
  "$schema": "{workspaceRoot}/node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "{projectRoot}/src",
  "prefix": "lib",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "defaultConfiguration": "production",
      "options": {
        "project": "{projectRoot}/ng-package.json",
        "tsConfig": "{projectRoot}/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "{projectRoot}/tsconfig.lib.prod.json"
        },
        "development": {}
      }
    },
    "test": {
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/jest.preset.js",
        "{workspaceRoot}/libs/backend/translate/assets/i18n/**/all.json",
        {
          "externalDependencies": ["jest", "@nx/jest", "ts-jest", "jest-preset-angular"]
        }
      ],
      "options": {
        "passWithNoTests": true
      },
      "configurations": {
        "ci": {
          "ci": true,
          "coverage": true
        }
      }
    },
    "lint": {
      "inputs": [
        "default",
        "{workspaceRoot}/eslint.config.mjs",
        "{workspaceRoot}/.eslintignore",
        "{workspaceRoot}/eslint.config.js",
        {
          "externalDependencies": ["eslint"]
        }
      ]
    }
  }
}
